{
  "manifest_version": 3,
  "name": "Orbit Watcher",
  "version": "1.0.0",
  "description": "Reports active public web pages to Orbit on this computer.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html"
}
